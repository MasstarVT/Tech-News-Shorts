# Copy to .env (`technews init` does it) and fill in what you use. Never commit .env.

# --- Script writer (only if you route llm.tasks.script to a cloud provider) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Voice (only with voice.engine: elevenlabs) --- elevenlabs.io -> Developers -> API keys
ELEVENLABS_API_KEY=

# --- Review on your phone: videos are posted here when they finish rendering ---
# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- TikTok (Content Posting API, inbox drafts) ---
# https://developers.tiktok.com/apps -> your app -> Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# YouTube: save the OAuth Desktop client JSON as config/secrets/youtube_client_secret.json,
# then run `uv run technews auth youtube`.

# Optional: a chrome-headless-shell for rendering (Remotion downloads one automatically otherwise)
REMOTION_BROWSER_EXECUTABLE=
